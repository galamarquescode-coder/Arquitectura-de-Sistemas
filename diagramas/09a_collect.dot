digraph G {
 graph [fontname="DejaVu Sans", fontsize=13, pad=0.3, nodesep=0.4, ranksep=0.42, dpi=120, rankdir=TB];
 node [fontname="DejaVu Sans", fontsize=11, style=filled, fillcolor=white, color="#34495e", penwidth=1.3];
 edge [fontname="DejaVu Sans", fontsize=10, color="#34495e", arrowsize=0.8];
 s [label="wificollector_collect()", shape=box, style="rounded,filled", fillcolor="#d6eaf8"];
 a0 [label="add_another = INP_YES", shape=box];
 a1 [label="¿add_another == INP_YES?", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 a2 [label="cell_id = input_ask_number(1..21)", shape=parallelogram, fillcolor="#d5f5e3"];
 a3 [label="¿INP_EOF?\n(se acabó la entrada)", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 a4 [label="collect_one_cell(cell_id)\n(ver diagrama 09b)", shape=box];
 a5 [label="add_another = input_ask_yes_no(\n¿Desea añadir otro punto de acceso?)", shape=parallelogram, fillcolor="#d5f5e3"];
 a6 [label="return", shape=box, style="rounded,filled", fillcolor="#e8daef"];
 s -> a0;
 a0 -> a1;
 a1 -> a2 [label="sí"];
 a1 -> a6 [label="no"];
 a2 -> a3;
 a3 -> a6 [label="sí"];
 a3 -> a4 [label="no"];
 a4 -> a5;
 a5 -> a1 [constraint=false];
}
