digraph G {
 graph [fontname="DejaVu Sans", fontsize=13, pad=0.3, nodesep=0.4, ranksep=0.42, dpi=120, rankdir=TB];
 node [fontname="DejaVu Sans", fontsize=11, style=filled, fillcolor=white, color="#34495e", penwidth=1.3];
 edge [fontname="DejaVu Sans", fontsize=10, color="#34495e", arrowsize=0.8];
 subgraph cluster_a { label="wificollector_display()"; style=dashed; color="#7f8c8d";
 a0 [label="display_another = INP_YES", shape=box];
 a1 [label="¿display_another\n== INP_YES?", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 a2 [label="cell_id = input_ask_number(1..21)", shape=parallelogram, fillcolor="#d5f5e3"];
 a3 [label="¿INP_EOF?", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 a4 [label="printed = print_cells_with_id(cell_id)", shape=box];
 a5 [label="¿printed == 0?", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 a6 [label="Error: la celda no ha sido\nañadida con collect", shape=box, fillcolor="#fadbd8"];
 a7 [label="display_another = input_ask_yes_no(\n¿otra celda?)", shape=parallelogram, fillcolor="#d5f5e3"];
 a8 [label="return", shape=box, style="rounded,filled", fillcolor="#e8daef"];
 }
 subgraph cluster_b { label="print_cells_with_id(cell_id)"; style=dashed; color="#7f8c8d";
 b0 [label="printed = 0, i = 0", shape=box];
 b1 [label="¿i < num_cells?", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 b2 [label="¿cells[i].cell_id\n== cell_id?", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 b3 [label="cell_print(cells[i])\nprinted++", shape=parallelogram, fillcolor="#d5f5e3"];
 b4 [label="i++", shape=box];
 b5 [label="return printed", shape=box, style="rounded,filled", fillcolor="#e8daef"];
 }
 subgraph cluster_c { label="wificollector_display_all()"; style=dashed; color="#7f8c8d";
 c0 [label="¿num_cells == 0?", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 c1 [label="No hay información\nalmacenada", shape=box, fillcolor="#fadbd8"];
 c2 [label="para i = 0 .. num_cells-1:\ncell_print(cells[i])", shape=box];
 }
 a0 -> a1;
 a1 -> a2 [label="sí"];
 a1 -> a8 [label="no"];
 a2 -> a3;
 a3 -> a8 [label="sí"];
 a3 -> a4 [label="no"];
 a4 -> b0 [label="llama"];
 a4 -> a5;
 a5 -> a6 [label="sí"];
 a5 -> a7 [label="no"];
 a6 -> a7;
 a7 -> a1;
 b0 -> b1;
 b1 -> b2 [label="sí"];
 b1 -> b5 [label="no"];
 b2 -> b3 [label="sí"];
 b2 -> b4 [label="no"];
 b3 -> b4;
 b4 -> b1;
 c0 -> c1 [label="sí"];
 c0 -> c2 [label="no"];
}
