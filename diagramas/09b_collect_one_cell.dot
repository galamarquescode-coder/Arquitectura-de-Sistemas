digraph G {
 graph [fontname="DejaVu Sans", fontsize=13, pad=0.3, nodesep=0.4, ranksep=0.42, dpi=120, rankdir=TB];
 node [fontname="DejaVu Sans", fontsize=11, style=filled, fillcolor=white, color="#34495e", penwidth=1.3];
 edge [fontname="DejaVu Sans", fontsize=10, color="#34495e", arrowsize=0.8];
 s [label="collect_one_cell(cell_id)", shape=box, style="rounded,filled", fillcolor="#d6eaf8"];
 b0 [label="file_name = \"info_cell_N.txt\"\n(snprintf)", shape=box];
 b1 [label="file = fopen(file_name, \"r\")", shape=parallelogram, fillcolor="#d5f5e3"];
 b2 [label="¿file == NULL?", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 b3 [label="Error: no se pudo abrir el fichero", shape=box, fillcolor="#fadbd8"];
 b4 [label="¿status == CEL_READ_OK\ny num_cells < 200?", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 b5 [label="status = cell_read_block(\nfile, cells, num_cells)", shape=parallelogram, fillcolor="#d5f5e3"];
 b6 [label="¿status == CEL_READ_OK?", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 b7 [label="print_added_cell(): mensaje + cell_print\nnum_cells++ ; added++", shape=parallelogram, fillcolor="#d5f5e3"];
 b8 [label="fclose(file)", shape=parallelogram, fillcolor="#d5f5e3"];
 b9 [label="¿Cómo terminó\nel bucle?", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 b10 [label="ERROR: formato\nincorrecto", shape=box, fillcolor="#fadbd8"];
 b11 [label="OK: el array\nestá lleno", shape=box, fillcolor="#fadbd8"];
 b12 [label="END y added == 0:\nfichero vacío", shape=box, fillcolor="#fadbd8"];
 b13 [label="return", shape=box, style="rounded,filled", fillcolor="#e8daef"];
 s -> b0;
 b0 -> b1;
 b1 -> b2;
 b2 -> b3 [label="sí"];
 b2 -> b4 [label="no"];
 b3 -> b13;
 b4 -> b5 [label="sí"];
 b5 -> b6;
 b6 -> b7 [label="sí"];
 b7 -> b4 [constraint=false];
 b6 -> b4 [label="no", constraint=false];
 b4 -> b8 [label="no"];
 b8 -> b9;
 b9 -> b10 [label="status = ERROR"];
 b9 -> b11 [label="status = OK"];
 b9 -> b12 [label="status = END"];
 b10 -> b13;
 b11 -> b13;
 b12 -> b13;
}
