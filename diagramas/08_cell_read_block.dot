digraph G {
 graph [fontname="DejaVu Sans", fontsize=13, pad=0.3, nodesep=0.4, ranksep=0.42, dpi=120, rankdir=TB];
 node [fontname="DejaVu Sans", fontsize=11, style=filled, fillcolor=white, color="#34495e", penwidth=1.3];
 edge [fontname="DejaVu Sans", fontsize=10, color="#34495e", arrowsize=0.8];
 s [label="cell_read_block(file, cells, position)", shape=box, style="rounded,filled", fillcolor="#d6eaf8"];
 subgraph cluster_a { label="read_block_lines(file, lines)"; style=dashed; color="#7f8c8d";
 i [label="i = 0", shape=box];
 lp [label="¿i < 9?", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 fg [label="fgets(lines[i], 80, file)", shape=parallelogram, fillcolor="#d5f5e3"];
 nul [label="¿devolvió NULL?", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 i0 [label="¿i == 0?", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 inc [label="i++", shape=box];
 }
 rend [label="return CEL_READ_END\n(fin de fichero limpio)", shape=box, style="rounded,filled", fillcolor="#e8daef"];
 rerr [label="return CEL_READ_ERROR", shape=box, style="rounded,filled", fillcolor="#e8daef"];
 sc [label="converted = suma de los 9 sscanf\n(uno por línea)", shape=box];
 cv [label="¿converted == 10?", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 cp [label="cells[position] = cell", shape=box];
 rok [label="return CEL_READ_OK", shape=box, style="rounded,filled", fillcolor="#e8daef"];
 s -> i;
 i -> lp;
 lp -> fg [label="sí"];
 fg -> nul;
 nul -> i0 [label="sí"];
 nul -> inc [label="no"];
 i0 -> rend [label="sí"];
 i0 -> rerr [label="no\n(a mitad de bloque)"];
 inc -> lp [constraint=false];
 lp -> sc [label="no\n(las 9 leídas)"];
 sc -> cv;
 cv -> cp [label="sí"];
 cv -> rerr [label="no\n(formato incorrecto)"];
 cp -> rok;
}
