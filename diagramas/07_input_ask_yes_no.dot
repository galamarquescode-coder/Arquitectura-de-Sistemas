digraph G {
 graph [fontname="DejaVu Sans", fontsize=13, pad=0.3, nodesep=0.4, ranksep=0.42, dpi=120, rankdir=TB];
 node [fontname="DejaVu Sans", fontsize=11, style=filled, fillcolor=white, color="#34495e", penwidth=1.3];
 edge [fontname="DejaVu Sans", fontsize=10, color="#34495e", arrowsize=0.8];
 s [label="input_ask_yes_no(question)", shape=box, style="rounded,filled", fillcolor="#d6eaf8"];
 p [label="printf(question)", shape=parallelogram, fillcolor="#d5f5e3"];
 rl [label="input_read_line(line)", shape=parallelogram, fillcolor="#d5f5e3"];
 eof [label="¿se acabó\nla entrada?", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 rno0 [label="return INP_NO", shape=box, style="rounded,filled", fillcolor="#e8daef"];
 y [label="¿la línea es exactamente\n's' o 'S'?", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 ry [label="return INP_YES", shape=box, style="rounded,filled", fillcolor="#e8daef"];
 n [label="¿la línea es exactamente\n'n' o 'N'?", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 rno [label="return INP_NO", shape=box, style="rounded,filled", fillcolor="#e8daef"];
 er [label="Error: responda \"s\" o \"N\"", shape=box, fillcolor="#fadbd8"];
 s -> p;
 p -> rl;
 rl -> eof;
 eof -> rno0 [label="sí"];
 eof -> y [label="no"];
 y -> ry [label="sí"];
 y -> n [label="no"];
 n -> rno [label="sí"];
 n -> er [label="no"];
 er -> p [constraint=false];
}
