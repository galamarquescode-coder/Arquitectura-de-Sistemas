digraph G {
 graph [fontname="DejaVu Sans", fontsize=13, pad=0.3, nodesep=0.4, ranksep=0.42, dpi=120, rankdir=LR];
 node [fontname="DejaVu Sans", fontsize=11, style=filled, fillcolor=white, color="#34495e", penwidth=1.3];
 edge [fontname="DejaVu Sans", fontsize=10, color="#34495e", arrowsize=0.8];
 a [label="Inicio / Fin", shape=box, style="rounded,filled", fillcolor="#d6eaf8"];
 b [label="Proceso: una acción\n(asignar, llamar a una función)", shape=box];
 c [label="¿Condición?", shape=diamond, fillcolor="#fcf3cf", margin="0.05,0.02"];
 d [label="Entrada / salida\n(teclado, pantalla, fichero)", shape=parallelogram, fillcolor="#d5f5e3"];
 f [label="Mensaje de error", shape=box, fillcolor="#fadbd8"];
 g [label="return (devuelve\nun valor y termina)", shape=box, style="rounded,filled", fillcolor="#e8daef"];
 {rank=same; a; b; c; d; f; g}
 a -> b -> c -> d -> f -> g [style=invis];
}
